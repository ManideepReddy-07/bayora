# Backend
BAYORA_DATABASE_URL=sqlite:///./bayora.db
BAYORA_CORS_ORIGINS=http://localhost:5173
BAYORA_REQUEST_TIMEOUT_SECONDS=20
BAYORA_MAX_UPLOAD_BYTES=5242880
BAYORA_RATE_LIMIT_REQUESTS=20
BAYORA_RATE_LIMIT_WINDOW_SECONDS=60
# Signed local sessions. Change this to a long random value in any shared deployment.
BAYORA_AUTH_SECRET=replace-with-a-long-random-secret
# Development convenience only. Set false in a shared environment to require Bearer sessions.
BAYORA_ALLOW_DEMO_ROLE_HEADER=true
BAYORA_DEMO_PASSWORD=bayora-demo
# Provider keys live only in the server environment. Do not commit real values.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
